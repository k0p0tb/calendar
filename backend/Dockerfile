# ==========================================
# ЭТАП 1: Builder (Сборщик)
# ==========================================
# Берем официальный образ Go на базе легковесного Alpine Linux.
# Называем этот этап 'builder', чтобы потом скопировать из него скомпилированный бинарник.
FROM golang:1.24-alpine AS builder

# Устанавливаем рабочую директорию внутри контейнера сборщика
WORKDIR /app

# Шаг оптимизации слоев (Layer Caching):
# Сначала копируем ТОЛЬКО файлы описания зависимостей (go.mod и go.sum).
# Docker сохранит этот слой в кэш. Пока ты не добавишь новую библиотеку,
# шаг скачивания зависимостей будет браться из кэша за 0.1 секунды!
COPY go.mod go.sum ./
RUN go mod download

# Теперь копируем остальной исходный код бэкенда
COPY . .

# Компилируем бинарник:
# CGO_ENABLED=0  -> отключаем зависимость от системных C-библиотек (чистый статичный бинарник)
# GOOS=linux     -> целевая ОС Linux
# -ldflags="-w -s" -> флаги линковщика: вырезаем отладочную информацию (strip debug info),
#                     что уменьшает размер бинарника почти в 2 раза!
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/server ./cmd/api

# ==========================================
# ЭТАП 2: Runner (Минимальный боевой образ)
# ==========================================
# Для финального образа берем чистый Alpine Linux (~7 МБ)
FROM alpine:3.21 AS runner

# 1. ca-certificates — корневые SSL-сертификаты (нужны для исходящих HTTPS-запросов к Telegram Bot API)
# 2. tzdata — база часовых поясов (критично для календаря уроков!)
RUN apk --no-cache add ca-certificates tzdata

# Безопасность (Non-root user):
# В прод-среде запускать софт от суперпользователя (root) — табу.
# Создаем системную группу и ограниченного пользователя 'appuser'.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Переключаемся на непривилегированного пользователя
USER appuser

# Копируем ИЗ ЭТАПА BUILDER только готовый бинарник (никаких компиляторов и исходников!)
COPY --from=builder /bin/server /server

# Указываем, какой порт слушает сервис внутри контейнера
EXPOSE 8080

# Команда запуска контейнера
ENTRYPOINT ["/server"]
